<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  For a build signed with the hardened runtime (codesign - -options runtime,
  which notarisation requires): 86Box's recompiler maps its code buffers
  MAP_JIT (core/86box/host/host_plat_unix.c plat_mmap) and flips them with
  pthread_jit_write_protect_np on Apple silicon. Unsigned and ad-hoc signed
  builds run without the hardened runtime and need nothing.

    codesign - -force - -timestamp - -options runtime \
      - -entitlements frontends/macos/entitlements.plist \
      - -sign "$SIGN_IDENTITY" "FujiNet Go MS-DOS.app"

  (The dashes are spaced apart only because XML comments cannot hold two.)
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
