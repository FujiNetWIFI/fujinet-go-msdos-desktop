<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>online.fujinet.go.msdos.kde</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>FujiNet Go MS-DOS (KDE)</name>
  <summary>IBM PCs from the 5150 to the Pentium with a built-in FujiNet</summary>
  <description>
    <p>
      The IBM PC, PC/XT and PCjr, and typical 286, 386, 486 and Pentium
      machines, with a FujiNet on a serial port: browse network hosts from
      FujiNet's CONFIG program, mount disk images over the network, and run
      network programs under DOS, all in one application.
    </p>
    <p>
      The emulator is 86Box. MDA, CGA, EGA, VGA and Trident 8900 SVGA video,
      AdLib, Sound Blaster, Gravis UltraSound and MT-32 sound, floppy and hard
      disk images with the XT's common disk controllers. FujiNet runs inside
      the application on the COM port of your choice, and a FreeDOS boot
      floppy with FujiNet's driver and tools is built in.
    </p>
    <p>
      The machines' BIOS ROMs are not included: import them from files,
      folders or 86Box's ROM set.
    </p>
    <p>
      The keyboard and joysticks are on screen when wanted, gamepads are picked
      up as they are plugged in and out, and a native debugger shows the CPU,
      memory, disassembly with breakpoints on code, memory, I/O ports and
      interrupts, a DOS call trace and FujiNet's serial traffic.
    </p>
  </description>
  <launchable type="desktop-id">online.fujinet.go.msdos.kde.desktop</launchable>
  <icon type="stock">online.fujinet.go.msdos.kde</icon>
  <!-- Software centres classify from these, not from the .desktop
       Categories= line; without them the app lands in no section at all. -->
  <categories>
    <category>Game</category>
    <category>Emulator</category>
  </categories>
  <screenshots>
    <screenshot type="default">
      <caption>FujiNet's CONFIG on an IBM PC/XT, browsing hosts and drive slots</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-msdos-desktop/v0.8.0/data/screenshots/kde/1_running_config.png</image>
    </screenshot>
    <screenshot>
      <caption>The debugger stopped at a memory write: breakpoints, registers and thirteen tabs</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-msdos-desktop/v0.8.0/data/screenshots/kde/2_debugger.png</image>
    </screenshot>
    <screenshot>
      <caption>Preferences</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-msdos-desktop/v0.8.0/data/screenshots/kde/3_preferences.png</image>
    </screenshot>
  </screenshots>
  <url type="homepage">https://fujinet.online/</url>
  <url type="bugtracker">https://github.com/FujiNetWIFI/fujinet-go-msdos-desktop/issues</url>
  <url type="help">https://github.com/FujiNetWIFI/fujinet-go-msdos-desktop/blob/main/data/help/help.md</url>
  <developer id="online.fujinet">
    <name>FujiNet</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <releases>
    <!-- The CURRENT release templates its version from @PROJECT_VERSION@, so
         it cannot disagree with the tree; past releases are literal. The
         release job checks that this first entry is still a template. -->
    <release version="@PROJECT_VERSION@" date="2026-11-20">
      <description>
        <p>
          The Controllers panel is redrawn like the real hardware: the IBM Model F keyboard on the 5150 and 5160, the original PCjr chiclet keyboard on the PCjr, and a 101-key keyboard on the 286 and later, with two Kraft joysticks. Gamepads and the panel no longer fight over the joystick; Map assigns keys and gamepad buttons to the sixteen joystick controls, and gamepad-to-joystick choices are remembered. New Use gamepads and Reset Controls settings. On macOS the panel no longer floats over other apps.
        </p>
      </description>
    </release>
    <release version="0.9.1" date="2026-11-19">
      <description>
        <p>
          The IBM PCjr now boots: its built-in FujiNet boot floppy is PC-DOS 2.10 with FujiNet's drivers and tools, because FreeDOS never reached DOS on that machine. Other machines keep the FreeDOS floppy.
        </p>
      </description>
    </release>
    <release version="0.9.0" date="2026-11-17">
      <description>
        <p>
          macOS: the picture is drawn with Metal in step with the display, so it is smoother on 60 and 120 Hz screens; the emulator runs with game-grade scheduling priority; and the app opts into macOS Game Mode when it is full screen.
        </p>
      </description>
    </release>
    <release version="0.8.0" date="2026-11-16">
      <description>
        <p>
          A thirteen-tab debugger: Console, Disassembly, Memory, Breakpoints, Watches, Machine and I/O, Trace, History, Video, Sound, Symbols, Interrupts and FujiNet, with editable registers under every tab and Pop Out. Expressions and conditions on every breakpoint (value and old on memory writes), an instruction trace and history, the PC speaker and OPL decoded, and a memory map. Fix: writing CS or IP on an 8088 no longer runs stale prefetched bytes.
        </p>
      </description>
    </release>
    <release version="0.7.1" date="2026-11-13">
      <description>
        <p>
          Fix: on macOS the app no longer crashes when you quit it.
        </p>
      </description>
    </release>
    <release version="0.7.0" date="2026-11-07">
      <description>
        <p>
          New: a Video tab in the debugger for every video card the app offers (MDA, CGA, PCjr, EGA, VGA, Trident). It shows the decoded picture, the last finished frame and the live beam, plus registers, palette, memory map, character set, bit planes, per-pixel values and a heat map of recent VRAM writes.
        </p>
      </description>
    </release>
    <release version="0.6.2" date="2026-11-04">
      <description>
        <p>
          Fix: copying a file onto a drive mapped by fnshare no longer fails. DOS sets a file's length with a zero-byte write, and the built-in FujiNet now accepts it.
        </p>
      </description>
    </release>
    <release version="0.6.1" date="2026-11-04">
      <description>
        <p>
          Fix: copying a file onto a drive mapped by fnshare no longer fails. DOS sets a file's length with a zero-byte write, and the built-in FujiNet now accepts it.
        </p>
      </description>
    </release>
    <release version="0.6.0" date="2026-11-01">
      <description>
        <p>
          Lower CPU use: the picture is drawn on the GPU (with a software fallback) only when the emulator has a new frame, and the display stops updating while the window is hidden. The built-in FujiNet wakes about a tenth as often when nothing is happening. The PC emulator now runs in 10 ms slices instead of 1 ms ones, which cuts its wakeups about tenfold. Needs Qt 6.7 or newer.
        </p>
      </description>
    </release>
    <release version="0.5.0" date="2026-10-29">
      <description>
        <p>
          New: use an external FujiNet. A switch in Preferences makes the app connect to another FujiNet instance at a host:port you enter (for example 127.0.0.1:11516) instead of starting the built-in one.
        </p>
      </description>
    </release>
    <release version="0.4.2" date="2026-10-27">
      <description>
        <p>
          The Flatpak bundles now name Flathub as their runtime repository, so a downloaded bundle can fetch the GNOME or KDE runtime on a machine that has not set up Flathub.
        </p>
      </description>
    </release>
    <release version="0.4.1" date="2026-10-27">
      <description>
        <p>
          The Flatpak builds on the GNOME 51 runtime. The software-centre
          listing now credits FujiNet as developer, declares the app icon,
          and shows a full set of screenshots for each frontend.
        </p>
      </description>
    </release>
    <release version="0.4.0" date="2026-10-27">
      <description>
        <p>
          Import BIOS links to the 86Box ROM set download. On Windows the
          picture is drawn with Direct3D 11, presented on vblank like a game.
        </p>
      </description>
    </release>
    <release version="0.3.0" date="2026-10-21">
      <description>
        <p>
          Built-in, searchable Help, with Help buttons that open the part
          you are looking at. A hard disk attached while the PC runs is
          there after Reset, with no restart. Current FujiNet firmware.
        </p>
      </description>
    </release>
    <release version="0.2.0" date="2026-10-21">
      <description>
        <p>
          Each machine keeps its own settings: CPU, memory, video, sound,
          drives, disks and the FujiNet COM port and speed. Earlier settings
          carry over to every machine. Current FujiNet firmware.
        </p>
      </description>
    </release>
    <release version="0.1.1" date="2026-10-18">
      <description>
        <p>
          FujiNet runs at the speed it is set to: about ten times faster at
          115200, with no lost replies.
        </p>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-18">
      <description>
        <p>
          First release: 86Box with an in-process FujiNet on a COM port, seven
          IBM PC machines from the 5150 to the Pentium, a built-in FreeDOS boot
          floppy, native GNOME, KDE, macOS and Windows frontends, the keyboard
          and joysticks on screen, hotplugged gamepads and a native debugger.
        </p>
      </description>
    </release>
  </releases>
</component>
